/* PASO source: "PASO uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "PASO usa i tuoi calendari per mostrare eventi e contesto di pianificazione quando abiliti l'accesso al calendario.";
/* PASO source: "PASO uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "PASO usa i tuoi calendari per mostrare eventi e contesto di pianificazione quando abiliti l'accesso al calendario.";
/* PASO source: "PASO uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "PASO usa i tuoi calendari per aggiungere eventi quando abiliti l'accesso al calendario.";
/* PASO source: "PASO uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "PASO usa la fotocamera quando scansioni un codice QR di configurazione del Gateway o chiedi al Gateway associato o all'assistente di acquisire una foto o un breve video da questo iPhone, ad esempio per connetterti al Gateway o mostrare all'assistente un documento, lo schermo di un dispositivo o uno spazio di lavoro.";
/* PASO source: "PASO uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "PASO usa i tuoi contatti per permetterti di cercare e fare riferimento alle persone mentre usi l'assistente.";
/* PASO source: "PASO discovers and connects to your PASO gateway on the local network." */
"NSLocalNetworkUsageDescription" = "PASO rileva e si connette al tuo gateway PASO sulla rete locale.";
/* PASO source: "PASO can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "PASO può condividere la tua posizione in background quando abiliti Sempre.";
/* PASO source: "PASO uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "PASO usa la tua posizione quando consenti la condivisione della posizione.";
/* PASO source: "PASO uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "PASO usa il microfono per chat in tempo reale, attivazione vocale, push-to-talk e note vocali.";
/* PASO source: "PASO may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "PASO può usare i dati di movimento per supportare interazioni e automazioni consapevoli del dispositivo.";
/* PASO source: "PASO reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "PASO legge i dati relativi a passi, sonno, frequenza cardiaca a riposo e allenamenti dall'app Salute di Apple per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* PASO source: "PASO does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "PASO non scrive nell'app Salute di Apple. Utilizza dati di sola lettura per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* PASO source: "PASO lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "PASO consente al tuo assistente di leggere le foto che autorizzi e ti permette di scegliere le foto da condividere.";
/* PASO source: "PASO uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "PASO usa i tuoi promemoria per elencare, aggiungere e completare attività quando abiliti l’accesso ai promemoria.";
/* PASO source: "PASO uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "PASO usa il riconoscimento vocale sul dispositivo per la modalità conversazione e l’attivazione vocale.";
