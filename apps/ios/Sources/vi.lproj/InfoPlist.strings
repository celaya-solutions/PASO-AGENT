/* PASO source: "PASO uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "PASO sử dụng lịch của bạn để hiển thị sự kiện và ngữ cảnh lên lịch khi bạn bật quyền truy cập lịch.";
/* PASO source: "PASO uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "PASO sử dụng lịch của bạn để hiển thị sự kiện và ngữ cảnh lên lịch khi bạn bật quyền truy cập lịch.";
/* PASO source: "PASO uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "PASO sử dụng lịch của bạn để thêm sự kiện khi bạn bật quyền truy cập lịch.";
/* PASO source: "PASO uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "PASO sử dụng camera khi bạn quét mã QR thiết lập Gateway hoặc yêu cầu Gateway đã ghép đôi hay trợ lý của bạn chụp ảnh hoặc quay video ngắn từ iPhone này, ví dụ như để kết nối với Gateway của bạn hoặc hiển thị cho trợ lý một tài liệu, màn hình thiết bị hoặc không gian làm việc.";
/* PASO source: "PASO uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "PASO sử dụng danh bạ của bạn để bạn có thể tìm kiếm và tham chiếu mọi người khi sử dụng trợ lý.";
/* PASO source: "PASO discovers and connects to your PASO gateway on the local network." */
"NSLocalNetworkUsageDescription" = "PASO phát hiện và kết nối với PASO gateway của bạn trên mạng cục bộ.";
/* PASO source: "PASO can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "PASO có thể chia sẻ vị trí của bạn trong nền khi bạn bật Luôn luôn.";
/* PASO source: "PASO uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "PASO sử dụng vị trí của bạn khi bạn cho phép chia sẻ vị trí.";
/* PASO source: "PASO uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "PASO sử dụng micrô cho trò chuyện thời gian thực, đánh thức bằng giọng nói, nhấn để nói và ghi chú thoại.";
/* PASO source: "PASO may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "PASO có thể sử dụng dữ liệu chuyển động để hỗ trợ các tương tác và tự động hóa nhận biết thiết bị.";
/* PASO source: "PASO reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "PASO đọc dữ liệu về số bước chân, giấc ngủ, nhịp tim khi nghỉ và hoạt động tập luyện của bạn từ ứng dụng Apple Health để tạo các bản tóm tắt mà bạn yêu cầu và gửi chúng thông qua Gateway đến nhà cung cấp AI mà bạn đã cấu hình.";
/* PASO source: "PASO does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "PASO không ghi dữ liệu vào ứng dụng Apple Health. PASO sử dụng dữ liệu chỉ đọc để tạo các bản tóm tắt mà bạn yêu cầu và gửi chúng thông qua Gateway đến nhà cung cấp AI mà bạn đã cấu hình.";
/* PASO source: "PASO lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "PASO cho phép trợ lý của bạn đọc những ảnh bạn cho phép và cho phép bạn chọn ảnh để chia sẻ.";
/* PASO source: "PASO uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "PASO sử dụng lời nhắc của bạn để liệt kê, thêm và hoàn tất tác vụ khi bạn bật quyền truy cập lời nhắc.";
/* PASO source: "PASO uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "PASO sử dụng nhận dạng giọng nói trên thiết bị cho chế độ trò chuyện và đánh thức bằng giọng nói.";
