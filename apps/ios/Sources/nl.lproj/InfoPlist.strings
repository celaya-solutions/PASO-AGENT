/* PASO source: "PASO uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "PASO gebruikt de camera wanneer je een QR-code voor Gateway-configuratie scant of je gekoppelde Gateway of assistent vraagt om een foto of korte video vanaf deze iPhone vast te leggen, bijvoorbeeld om verbinding te maken met je Gateway of om je assistent een document, apparaatscherm of werkruimte te tonen.";
/* PASO source: "PASO uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "PASO gebruikt je contacten zodat je personen kunt zoeken en vermelden terwijl je de assistent gebruikt.";
/* PASO source: "PASO discovers and connects to your PASO gateway on the local network." */
"NSLocalNetworkUsageDescription" = "PASO vindt en maakt verbinding met je PASO-gateway op het lokale netwerk.";
/* PASO source: "PASO can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "PASO kan je locatie op de achtergrond delen wanneer je Altijd inschakelt.";
/* PASO source: "PASO uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "PASO gebruikt je locatie wanneer je locatie delen toestaat.";
/* PASO source: "PASO uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "PASO gebruikt de microfoon voor realtime chat, spraakwake, push-to-talk en spraaknotities.";
/* PASO source: "PASO may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "PASO kan bewegingsgegevens gebruiken ter ondersteuning van apparaatafhankelijke interacties en automatiseringen.";
/* PASO source: "PASO reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "PASO leest je stappen, slaap, rusthartslag en work-outs uit de Apple Gezondheid-app om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* PASO source: "PASO does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "PASO schrijft geen gegevens naar de Apple Gezondheid-app. Het gebruikt alleen-lezengegevens om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* PASO source: "PASO lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "PASO laat je assistent foto’s lezen die je toestaat en laat je foto’s kiezen om te delen.";
/* PASO source: "PASO uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "PASO gebruikt je herinneringen om taken weer te geven, toe te voegen en te voltooien wanneer je toegang tot herinneringen inschakelt.";
/* PASO source: "PASO uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "PASO gebruikt spraakherkenning op het apparaat voor de praatmodus en spraakactivering.";
