"NSLocalNetworkUsageDescription" = "PASO descubre y se conecta a tu gateway de PASO en la red local.";
/* PASO source: "PASO can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "PASO puede compartir tu ubicación en segundo plano cuando activas Siempre.";
/* PASO source: "PASO uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "PASO usa tu ubicación cuando permites compartir la ubicación.";
/* PASO source: "PASO uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "PASO usa el micrófono para chat en tiempo real, activación por voz, pulsar para hablar y notas de voz.";
/* PASO source: "PASO may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "PASO puede usar datos de movimiento para admitir interacciones y automatizaciones conscientes del dispositivo.";
/* PASO source: "PASO reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "PASO lee tus pasos, sueño, frecuencia cardíaca en reposo y entrenamientos desde la app Salud de Apple para crear los resúmenes que solicites y enviarlos a través de tu Gateway al proveedor de IA configurado.";
/* PASO source: "PASO does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "PASO no escribe en la app Salud de Apple. Utiliza datos de solo lectura para crear los resúmenes que solicites y enviarlos a través de tu Gateway al proveedor de IA configurado.";
/* PASO source: "PASO lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "PASO permite que tu asistente lea las fotos que autorices y te permite elegir fotos para compartir.";
/* PASO source: "PASO uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "PASO usa tus recordatorios para listar, agregar y completar tareas cuando habilitas el acceso a recordatorios.";
/* PASO source: "PASO uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "PASO usa el reconocimiento de voz en el dispositivo para el modo de conversación y la activación por voz.";
